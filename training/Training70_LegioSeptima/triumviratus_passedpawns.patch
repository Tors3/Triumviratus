+struct PassedPawns {
+    static constexpr std::string_view NAME = "PassedPawns";
+
+    static constexpr int INPUTS              = 96;
+    static constexpr int MAX_ACTIVE_FEATURES = 16;  // tutti i pedoni passati (limite teorico)
+
+    // Stessa codifica di slot del pawn_id di PP_3Wide: 0..47 propri, 48..95 avversari.
+    static int pawn_id(Color persp, Square ksq, Color pc, Square sq) {
+        int o = int(sq) ^ int(FullThreats::OrientTBL[(int) persp][(int) ksq]);
+        return (pc != persp ? 48 : 0) + o - 8;  // i pedoni orientati vivono su 8..55 -> 0..47
+    }
+
+    // Test "passato" su case RAW: l'orientazione entra solo al momento dell'indice.
+    static bool is_passed(int s, bool white, const int* own, int nOwn, const int* opp, int nOpp) {
+        const int f = s & 7, r = s >> 3;
+        for (int i = 0; i < nOpp; i++)
+        {
+            const int of = opp[i] & 7, orr = opp[i] >> 3;
+            const int df = of - f;
+            if (df >= -1 && df <= 1 && (white ? orr > r : orr < r))
+                return false;
+        }
+        for (int i = 0; i < nOwn; i++)
+        {
+            if (own[i] == s)
+                continue;
+            const int orr = own[i] >> 3;
+            if ((own[i] & 7) == f && (white ? orr > r : orr < r))
+                return false;
+        }
+        return true;
+    }
+
+    // Conta i pedoni passati (entrambi i lati). Stessa verita' di fill_features_sparse:
+    // un solo posto dove "passato" e' definito.
+    static int count_passed(const TrainingDataEntry& e) {
+        auto& pos = e.pos;
+        int   wp[8], bp[8];
+        int   nw = 0, nb = 0;
+        for (Square s : pos.piecesBB(whitePawn))
+            wp[nw++] = int(s);
+        for (Square s : pos.piecesBB(blackPawn))
+            bp[nb++] = int(s);
+        int cnt = 0;
+        for (int i = 0; i < nw; i++)
+            if (is_passed(wp[i], true, wp, nw, bp, nb))
+                cnt++;
+        for (int i = 0; i < nb; i++)
+            if (is_passed(bp[i], false, bp, nb, wp, nw))
+                cnt++;
+        return cnt;
+    }
+
+    static std::pair<int, int>
+    fill_features_sparse(const TrainingDataEntry& e, int* features, Color color) {
+        auto&  pos = e.pos;
+        Square ksq = pos.kingSquare(color);
+
+        int wp[8], bp[8];
+        int nw = 0, nb = 0;
+        for (Square s : pos.piecesBB(whitePawn))
+            wp[nw++] = int(s);
+        for (Square s : pos.piecesBB(blackPawn))
+            bp[nb++] = int(s);
+
+        int k = 0;
+        for (int i = 0; i < nw; i++)
+            if (is_passed(wp[i], true, wp, nw, bp, nb))
+                features[k++] = pawn_id(color, ksq, Color::White, Square(wp[i]));
+        for (int i = 0; i < nb; i++)
+            if (is_passed(bp[i], false, bp, nb, wp, nw))
+                features[k++] = pawn_id(color, ksq, Color::Black, Square(bp[i]));
+        return {k, INPUTS};
+    }
+};
+
+struct PassedPawnsExtractor: IFeatureExtractor {
+    int inputs() const override { return PassedPawns::INPUTS; }
+    int max_active_features() const override { return PassedPawns::MAX_ACTIVE_FEATURES; }
+    std::pair<int, int> fill_features_sparse(const TrainingDataEntry& e,
+                                             int*                     features,
+                                             Color                    color) const override {
+        return PassedPawns::fill_features_sparse(e, features, color);
+    }
+};
