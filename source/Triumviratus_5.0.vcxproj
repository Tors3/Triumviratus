    <!-- Vendored Stockfish-master SFNNv13 NNUE (FullThreats + HalfKAv2_hm, L1=1024).
         Replaces the SFNNv10 + Bullet code (removed in M2). We compile only the subset
         the NNUE eval needs: position_min.cpp provides Position::set_pieces (the heavy
         master position.cpp / nnue_misc.cpp / evaluate.cpp pull movegen/uci closures and
         are NOT compiled). ObjectFileName routes objects to a subdir so nnue's
         misc.cpp / attacks.cpp / bitboard.cpp do not clash with the engine's own. -->
    <ClCompile Include="nnue\position_min.cpp">
      <ObjectFileName>$(IntDir)nnue\</ObjectFileName>
    </ClCompile>
