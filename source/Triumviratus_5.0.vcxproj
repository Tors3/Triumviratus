  <!-- Build con clang-cl (VS LLVM 19): MSBuild ... -p:PlatformToolset=ClangCL.
       Flag per-feature di clang (MSVC li ignora: gruppo condizionato al toolset).
       /arch:AVX512 di clang NON abilita VNNI/BMI2 -> li aggiungo qui per gli intrinsics. -->
  <ItemDefinitionGroup Condition="'$(PlatformToolset)'=='ClangCL'">
    <ClCompile>
      <AdditionalOptions>-O3 -flto=thin $(ClangPgoFlags) -mavx512f -mavx512bw -mavx512dq -mavx512vl -mavx512vnni -mbmi2 -mavx2 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <!-- runtime di profiling clang (per -fprofile-generate/-use); lld-link cerca clang_rt.profile.lib.
           Path RELATIVI: clang_rt_lib accanto al repo-root (lo crea build_pgo_clang.ps1, copia+rinomina la lib);
           $(ClangProfileLibDir) = dir lib-clang di VS, passata dallo script (-p:ClangProfileLibDir=...). Niente path assoluti. -->
      <AdditionalLibraryDirectories>$(MSBuildProjectDirectory)\..\clang_rt_lib;$(ClangProfileLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
