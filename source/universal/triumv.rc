// Universal executable: the same resources as Triumviratus_8.0.rc (icon and embedded network), in UTF-8 for llvm-rc,
// plus the version information (05/11/2026). triumv_version.h is written by ubuild_lib.ps1 (Build-CommonParts) from
// release.json into the object folder, so the file version is always the engine version.
#include "../resource.h"
#include "triumv_version.h"
IDI_MAIN_ICON ICON "../logo.ico"
NNUE_DEFAULT RCDATA "../nn-consilium.nnue"

1 VERSIONINFO
FILEVERSION TRIUMV_VER_NUM
PRODUCTVERSION TRIUMV_VER_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Francesco Torsello"
            VALUE "FileDescription", "Triumviratus UCI chess engine"
            VALUE "FileVersion", TRIUMV_VER_STR
            VALUE "InternalName", "Triumviratus"
            VALUE "LegalCopyright", "Copyright (C) 2024-2026 Francesco Torsello. Free software under the GNU GPL v3."
            VALUE "OriginalFilename", "Triumviratus.exe"
            VALUE "ProductName", "Triumviratus"
            VALUE "ProductVersion", TRIUMV_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
